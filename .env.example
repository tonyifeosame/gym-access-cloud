# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=at_admin
DB_PASSWORD=your_secure_password
DB_NAME=access_terminal

# Set to `require` (or stronger) whenever the database is reached over a
# network. `disable` is only appropriate for a local socket or container link.
DB_SSLMODE=disable

# Connection pool. Leaving this unbounded lets a fleet of terminals polling at
# once open a connection per in-flight request until PostgreSQL refuses more.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_CONN_MAX_IDLE_SECONDS=300

# Server Configuration
SERVER_PORT=8080
GIN_MODE=release

# Comma-separated origin allowlist for browser clients, e.g.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com
# Unset means responses are readable from any origin but never with credentials.
CORS_ALLOWED_ORIGINS=

# Require a bearer token on /metrics. Unset leaves it open, which is only safe
# when the endpoint is unreachable from outside the cluster -- it reports
# fleet-wide counts across every tenant.
METRICS_TOKEN=

# Sync engine
SYNC_COMPACTION_THRESHOLD=500

# Background maintenance
MAINTENANCE_ENABLED=true
DEVICE_OFFLINE_AFTER_SECONDS=300
SYNC_JOB_RETENTION_DAYS=90
