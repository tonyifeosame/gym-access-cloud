# Database Configuration
#
# DATABASE_URL supersedes every DB_* variable below when it is set. It is what
# managed providers hand out (Render, RDS, Neon) and what Render's blueprint
# wires in automatically. TLS is not optional on it: a URL with no sslmode gets
# `require`, and one that asks for `disable`/`allow`/`prefer` against anything
# other than loopback is refused rather than honoured.
#
# DATABASE_URL=postgres://user:password@host:5432/access_terminal?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=at_admin
DB_PASSWORD=your_secure_password
DB_NAME=access_terminal

# Set to `require` (or stronger) whenever the database is reached over a
# network. `disable` is only appropriate for a local socket or container link.
DB_SSLMODE=disable

# Connection pool. Leaving this unbounded lets a fleet of terminals polling at
# once open a connection per in-flight request until PostgreSQL refuses more.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_CONN_MAX_IDLE_SECONDS=300

# Server Configuration
#
# PORT wins over SERVER_PORT when both are set. Container platforms inject PORT
# and route to whatever the process bound there; SERVER_PORT stays as the
# fallback the compose and systemd deployments use.
SERVER_PORT=8080

# Interface to bind. 0.0.0.0 is required on a container platform -- the proxy
# and the health check both arrive over the container's network interface, and
# a process on 127.0.0.1 answers neither. Set it to 127.0.0.1 on a host where
# Nginx terminates TLS alongside the API, to keep it off every other interface.
BIND_ADDRESS=0.0.0.0

GIN_MODE=release

# Whose X-Forwarded-For to believe. Comma-separated IPs/CIDRs; `none` ignores
# the header entirely and reports the peer address. Unset means loopback, which
# matches the Nginx-on-the-same-host deployment. Use `none` behind a proxy whose
# address you do not control -- the recorded device address is written from this.
TRUSTED_PROXIES=

# Comma-separated origin allowlist for browser clients.
#
# REQUIRED FOR THE OPERATOR DASHBOARD. The console authenticates with a cookie,
# and a browser only sends one cross-origin when the response carries
# Access-Control-Allow-Credentials with an EXACT origin -- which happens only for
# an origin on this list. Unset means responses stay readable from anywhere but
# never with credentials, so login silently cannot work. The server warns at
# startup when it is empty.
#
# Production:
#   CORS_ALLOWED_ORIGINS=https://app.accesslink.store
#
# Local development through the Vite proxy needs nothing here: the dashboard and
# the API are the same origin, so no CORS is involved at all. Add
# http://localhost:5173 only if you point the dev server straight at the API.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Operator sessions (the browser dashboard)
# ---------------------------------------------------------------------------
#
# The production cookie is fixed and not configurable:
#
#   __Host-al_session; Secure; HttpOnly; SameSite=Lax; Path=/   (no Domain)
#
# The __Host- prefix is enforced by the browser -- it refuses the cookie unless
# Secure and Path=/ are set and Domain is absent -- which makes it host-only and
# un-settable by any sibling subdomain of the API.
#
# app.accesslink.store and api.accesslink.store share the registrable domain
# accesslink.store, so they are same-site and SameSite=Lax sends the cookie. A
# dashboard on an unrelated domain would NOT work; keep both under one domain.

# How long a session survives without being used. Slides forward as it is used.
SESSION_IDLE_TIMEOUT_SECONDS=43200

# The hard cap. Never slides, so a background tab cannot keep a session alive.
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800

# bcrypt work factor for operator passwords. Floor of 10 is enforced in code.
BCRYPT_COST=12

# Credential attempts per client address per minute, shared by /auth/login,
# /auth/password, /auth/register and the handover routes. In-process, so the
# effective limit multiplies by the instance count; the per-account lockout in
# the database is what survives a restart.
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Terminal provisioning, per client address per minute. Its OWN bucket, never
# shared with login: a terminal polling every few seconds while a customer finds
# the console must not exhaust the allowance that customer needs to sign in, and
# an attacker hammering login must not stop somebody commissioning hardware.
#
# A SITE IS ONE ADDRESS. Every terminal in a building shares the customer's
# public IP and each polls twelve times a minute, so this is the number that
# decides how many doors can be commissioned at once: 300 covers twenty-five.
# It was 60, which was five, and the refusals landed on the customer installing
# hardware rather than on anybody attacking anything.
ANNOUNCE_RATE_LIMIT_PER_MINUTE=300

# Terminal provisioning, per TERMINAL per minute -- keyed on the serial it
# announces or the token it polls with, whatever address it arrives from.
#
# This is what makes the address allowance above safe to raise: one device in a
# loop is bounded by its own behaviour, so it cannot spend a whole site's
# budget. Twenty against a legitimate peak of about fourteen.
ANNOUNCE_DEVICE_RATE_LIMIT_PER_MINUTE=20

# Pairing-code attempts per SIGNED-IN SESSION per minute.
#
# The limiter that actually protects the code. An attacker guessing one already
# holds an operator session, which an address-keyed bucket does not bound; at
# this rate 39 bits is unreachable many times over before a 15-minute code
# expires. An operator mistyping a code is nowhere near it.
ADOPT_RATE_LIMIT_PER_MINUTE=10

# Self-service signup: POST /auth/register creates a company, its first site and
# its OWNER, and signs that owner in. DEFAULT ON -- a console with no way in is
# the problem this endpoint exists to solve.
#
# Set to false for an installation run for a single organisation, or one behind
# a private network, where an anonymous endpoint that creates tenants is a
# surface with no customer behind it. Disabled, the route answers 403 rather
# than 404, so whoever hits it looks for this variable instead of for a typo.
#
# It never returns a site provisioning key, and it cannot reach anything in the
# platform-administration tree.
PUBLIC_SIGNUP_ENABLED=true

# LOCAL DEVELOPMENT ONLY -- NEVER SET THIS IN A DEPLOYMENT.
#
# Drops Secure and renames the cookie to `al_session`. The rename is not
# optional: a __Host- cookie without Secure is rejected outright by the browser,
# so the prefix has to go with it. Exactly one name is accepted at a time, so
# this also stops the production cookie being honoured while it is set. The
# server logs a warning on first use.
#
# Most development does not need it: Chrome and Firefox treat http://localhost
# as a secure context and accept Secure cookies there.
SESSION_COOKIE_INSECURE=

# ---------------------------------------------------------------------------
# First operator bootstrap
# ---------------------------------------------------------------------------
#
# A database built from migrations/ has no operator accounts, so a fresh
# deployment has no way into the console. These create the first one at startup.
#
# THEY ONLY EVER ACT ON AN EMPTY SYSTEM. If a single live operator exists -- even
# a disabled one -- the bootstrap does nothing and warns that the variables
# should be removed. It cannot overwrite an account, reset a password, re-enable
# one or change a role.
#
# Both are required together: setting only one fails startup. An invalid address,
# a password below the 12-character policy or an unknown company slug also fails
# startup, but ONLY when the bootstrap would actually run -- on an established
# system the values are never read for their content, so a stale variable cannot
# stop the API booting.
#
# Set them once, sign in, then remove them from the environment.
BOOTSTRAP_OPERATOR_EMAIL=
BOOTSTRAP_OPERATOR_PASSWORD=

# Optional. The company slug the first OWNER joins. Defaults to the oldest
# company; an unknown slug fails startup rather than inventing a tenant.
BOOTSTRAP_OPERATOR_COMPANY=

# Optional. Display name for the first OWNER. Defaults to the local part of the
# email address, because full_name cannot be blank.
BOOTSTRAP_OPERATOR_NAME=

# Require a bearer token on /metrics. Unset leaves it open, which is only safe
# when the endpoint is unreachable from outside the cluster -- it reports
# fleet-wide counts across every tenant.
METRICS_TOKEN=

# Sync engine
SYNC_COMPACTION_THRESHOLD=500

# Background maintenance
MAINTENANCE_ENABLED=true
DEVICE_OFFLINE_AFTER_SECONDS=300
SYNC_JOB_RETENTION_DAYS=90

# How long a DEAD operator session row is kept before deletion, and how often
# the sweep runs. Expired and revoked sessions authenticate nothing, but the row
# answers "who signed in, when, from where" after an incident. The sweep cannot
# log anyone out: it only matches rows that are already expired or revoked.
SESSION_RETENTION_DAYS=30
SESSION_PURGE_INTERVAL_SECONDS=21600

# Provisioning housekeeping: terminal announcements and claim codes.
#
# The sweep times out lapsed announcements and deletes finished ones, and it is
# DELIBERATELY NOT LOAD-BEARING -- announcing expires that serial's own stale
# rows in its own transaction, and every lookup carries its own expiry
# predicate, so a customer can still add a terminal with this turned off. What
# it is for is the console: an operator's "waiting to be set up" list should not
# fill with rows that timed out an hour ago.
#
# Retention keeps finished announcements and expired claim codes for a window,
# because "did a unit ever try to join this account, and what happened to it" is
# a support question. 0 disables deletion and keeps them for ever.
PROVISIONING_SWEEP_INTERVAL_SECONDS=60
PROVISIONING_RETENTION_DAYS=30
