# Production environment for the Access Terminal Cloud API.
#
# Copy to deploy/.env.production, fill in, and keep it OUT of git:
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# deploy/.env.production is gitignored. Verify before the first deploy:
#   git check-ignore -v deploy/.env.production
#
# Every value below is read by the application; the full list came from
# grepping os.Getenv/getEnv across the tree, so there are no hidden knobs.

# --- database ---------------------------------------------------------------
# Generate the password, do not choose it:
#   openssl rand -hex 32
DB_USER=at_admin
DB_PASSWORD=
DB_NAME=access_terminal

# `require` encrypts without needing the server certificate distributed to the
# API container. Use verify-full once the database is off-host, and supply the
# CA -- `require` alone does not authenticate the server.
DB_SSLMODE=require

# --- API --------------------------------------------------------------------
SERVER_PORT=8080
GIN_MODE=release

# Comma-separated allowlist for browser clients (an operator dashboard).
# LEAVE EMPTY if there is no browser client: empty means "readable from any
# origin but never with credentials", which is the safe reading. A value here
# enables credentialed cross-origin requests, so put only hosts you control.
# Terminals are unaffected either way -- CORS is a browser mechanism and an
# ESP32 sends no Origin header.
CORS_ALLOWED_ORIGINS=

# Required in production. Without it /metrics is unauthenticated, and it
# exposes device counts, site names and job backlogs.
#   openssl rand -hex 32
METRICS_TOKEN=

# --- background maintenance -------------------------------------------------
# Without the sweep a terminal that loses power stays ONLINE forever.
MAINTENANCE_ENABLED=true

# Mark a device OFFLINE after this long without a heartbeat. Must be comfortably
# longer than the terminals' poll interval or a healthy fleet flaps; three
# missed heartbeats is the usual rule. Terminals default to 60 s.
DEVICE_OFFLINE_AFTER_SECONDS=180
OFFLINE_SWEEP_INTERVAL_SECONDS=60

# Delivered job history. 0 disables pruning, which grows sync_jobs forever.
SYNC_JOB_RETENTION_DAYS=90

# Backlog size at which a device's queue is collapsed into a snapshot instead of
# replaying history. Lower it if terminals are offline for long stretches.
SYNC_COMPACTION_THRESHOLD=500

# --- build metadata (stamped into the image) --------------------------------
# Set by the deploy command, not by hand:
#   VERSION=$(git describe --tags --always --dirty) COMMIT=$(git rev-parse --short HEAD)
VERSION=
COMMIT=
