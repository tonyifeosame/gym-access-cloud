# Production environment for the Access Terminal Cloud API.
#
# Copy to deploy/.env.production, fill in, and keep it OUT of git:
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# deploy/.env.production is gitignored. Verify before the first deploy:
#   git check-ignore -v deploy/.env.production
#
# Every value below is read by the application; the full list came from
# grepping os.Getenv/getEnv across the tree, so there are no hidden knobs.

# --- database ---------------------------------------------------------------
# Generate the password, do not choose it:
#   openssl rand -hex 32
DB_USER=at_admin
DB_PASSWORD=
DB_NAME=access_terminal

# Host and port. The compose stack overrides these to reach the postgres service
# over its internal network, so they matter for the systemd deployment and for
# running deploy/migrate.sh from this host.
DB_HOST=localhost
DB_PORT=5432

# `disable` is correct ONLY where the database is on this host, or on a private
# bridge with nothing else on it -- which is the compose stack as shipped.
#
# It is not a placeholder for `require`. The postgres image has ssl off and
# generates no certificate, so `require` there fails at startup with "SSL is not
# enabled on the server". And `require` encrypts without authenticating the
# server, so it stops a passive listener and not an active one.
#
# When the database moves off this host, go to verify-full -- not require -- and
# give the client the CA. See "Moving the database off-host" in deploy/README.md.
DB_SSLMODE=disable

# Connection pool. Unbounded is the dangerous default: a fleet polling at once
# opens a connection per in-flight request until PostgreSQL refuses new ones,
# and then every request fails instead of queueing. Raise max_connections on the
# server before raising this.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_CONN_MAX_IDLE_SECONDS=300

# --- API --------------------------------------------------------------------
SERVER_PORT=8080
GIN_MODE=release

# Interface to bind. The default is 0.0.0.0, which is what a container platform
# requires -- but on the SYSTEMD deployment the API runs on the host with Nginx
# beside it, and nothing outside should reach 8080 directly. 127.0.0.1 there.
#
# Leave it unset for the COMPOSE deployment: the container must bind 0.0.0.0 for
# the published port to reach it, and docker-compose.prod.yml already restricts
# exposure by publishing on "127.0.0.1:8080:8080".
BIND_ADDRESS=127.0.0.1

# Whose X-Forwarded-For the API believes. It records the caller's address on the
# device row, so trusting the wrong party makes that field spoofable, and
# trusting nobody records the whole fleet at the proxy's address.
#
#   systemd deployment (Nginx and API both on the host)  -> 127.0.0.1,::1
#   compose deployment (Nginx on host, API in container) -> 172.16.0.0/12
#   no proxy in front at all                             -> none
#
# Empty means loopback. The literal `none` ignores X-Forwarded-For entirely.
TRUSTED_PROXIES=127.0.0.1,::1

# Comma-separated allowlist for browser clients (an operator dashboard).
# LEAVE EMPTY if there is no browser client: empty means "readable from any
# origin but never with credentials", which is the safe reading. A value here
# enables credentialed cross-origin requests, so put only hosts you control.
# Terminals are unaffected either way -- CORS is a browser mechanism and an
# ESP32 sends no Origin header.
CORS_ALLOWED_ORIGINS=

# Required in production. Without it /metrics is unauthenticated, and it
# exposes device counts, site names and job backlogs.
#   openssl rand -hex 32
METRICS_TOKEN=

# --- background maintenance -------------------------------------------------
# Without the sweep a terminal that loses power stays ONLINE forever.
MAINTENANCE_ENABLED=true

# Mark a device OFFLINE after this long without a heartbeat. Must be comfortably
# longer than the terminals' poll interval or a healthy fleet flaps; three
# missed heartbeats is the usual rule. Terminals default to 60 s.
DEVICE_OFFLINE_AFTER_SECONDS=180
OFFLINE_SWEEP_INTERVAL_SECONDS=60

# Delivered job history. 0 disables pruning, which grows sync_jobs forever.
SYNC_JOB_RETENTION_DAYS=90
SYNC_JOB_PRUNE_INTERVAL_SECONDS=3600

# How long shutdown waits for a maintenance task already in flight. Longer than
# this and it is abandoned; the tasks are all restartable, so that is safe.
MAINTENANCE_SHUTDOWN_TIMEOUT_SECONDS=10

# Backlog size at which a device's queue is collapsed into a snapshot instead of
# replaying history. Lower it if terminals are offline for long stretches.
SYNC_COMPACTION_THRESHOLD=500

# --- build metadata (stamped into the image) --------------------------------
# Set by the deploy command, not by hand:
#   VERSION=$(git describe --tags --always --dirty) COMMIT=$(git rev-parse --short HEAD)
VERSION=
COMMIT=
