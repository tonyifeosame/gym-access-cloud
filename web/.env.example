# AccessLink console configuration.
#
# Only VITE_-prefixed variables reach the browser bundle. Nothing secret belongs
# in this file or in any variable below: everything here is public the moment the
# app is served. In particular there is NO site API key here, and there never
# can be -- the console authenticates with an operator session cookie, and the
# site key is a provisioning secret that stays on the server side.

# Where the API lives.
#
# Leave EMPTY for local development: requests then go to the dev server's own
# origin and Vite proxies /api to the Go server, which keeps the browser
# same-origin and avoids CORS entirely.
#
# Production:
#   VITE_API_BASE_URL=https://api.accesslink.store
#
# with the console served from https://app.accesslink.store and the API's
# CORS_ALLOWED_ORIGINS set to that exact origin.
VITE_API_BASE_URL=

# Where the dev proxy forwards to. Defaults to http://localhost:8080.
VITE_DEV_API_TARGET=
