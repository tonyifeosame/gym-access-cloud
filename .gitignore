# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
access-terminal-cloud-api

# Test binary, built with `go test -c`
*.test

# Written by the integration suite: which server it last connected to, and when.
# Also what keeps the suite out of the test cache -- see main_test.go.
.integration-run

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# Environment variables
.env

# Production secrets. The .example alongside it IS committed; the filled-in one
# holds the database password and the metrics token and must never be.
deploy/.env.production
deploy/.env.production.local

# Database dumps taken by the backup command in deploy/README.md -- these
# contain the full member roster and every device credential hash.
deploy/backups/
*.dump

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
